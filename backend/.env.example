# Application
APP_NAME=AutoSense AI Platform
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/autosense_db
DB_ECHO=False

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LLM API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=anthropic  # or "openai"
LLM_MODEL=claude-3-sonnet-20240229  # or "gpt-4-turbo-preview"

# ML Models
ML_MODEL_PATH=../ml/models/failure_prediction_model.pkl
SHAP_EXPLAINER_PATH=../ml/models/shap_explainer.pkl

# RAG Configuration
RAG_INDEX_PATH=app/rag/indices/faiss_index
RAG_EMBEDDINGS_MODEL=all-MiniLM-L6-v2
RAG_TOP_K_RESULTS=5

# File Storage
STORAGE_TYPE=local  # or "s3"
STORAGE_PATH=./uploads
# S3_BUCKET_NAME=autosense-files
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# WebSocket
WS_HEARTBEAT_INTERVAL=30

# Redis (for production real-time features)
# REDIS_URL=redis://localhost:6379/0

# Email (for notifications - Phase 2)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@autosense.ai

# SMS (for notifications - Phase 2)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Monitoring (optional)
# SENTRY_DSN=
